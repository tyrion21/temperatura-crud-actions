# Variables de entorno para desarrollo local
# Copia este archivo a .env y ajusta los valores según tu configuración

# ======================
# DATABASE CONFIGURATION
# ======================
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=temperatura_db
DB_USER=sa
DB_PASSWORD=j1s0n2108*
DB_CONNECTION_STRING=jdbc:sqlserver://${DB_SERVER}:${DB_PORT};databaseName=${DB_NAME};encrypt=true;trustServerCertificate=true

# ======================
# BACKEND CONFIGURATION
# ======================
BACKEND_PORT=8081
SPRING_PROFILES_ACTIVE=dev
JAVA_OPTS=-Xmx512m -Xms256m -XX:+UseG1GC

# ======================
# FRONTEND CONFIGURATION
# ======================
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8081
NODE_ENV=development

# ======================
# DOCKER CONFIGURATION
# ======================
DOCKER_BACKEND_IMAGE=jasonhermida/temperatura-backend
DOCKER_FRONTEND_IMAGE=jasonhermida/temperatura-frontend
DOCKER_USERNAME=jasonhermida
DOCKER_PASSWORD=

# ======================
# TESTING CONFIGURATION
# ======================
TEST_DB_NAME=temperatura_test_db
TEST_BACKEND_PORT=8082
TEST_FRONTEND_PORT=3001

# ======================
# STAGING CONFIGURATION
# ======================
STAGING_DB_NAME=temperatura_staging_db
STAGING_DB_PORT=1434
STAGING_BACKEND_PORT=8081
STAGING_FRONTEND_PORT=3000

# ======================
# PRODUCTION CONFIGURATION
# ======================
PROD_DB_NAME=temperatura_db
PROD_DB_PORT=1435
PROD_BACKEND_PORT=8083
PROD_FRONTEND_PORT=3002
PROD_JAVA_OPTS=-Xmx1g -Xms512m -XX:+UseG1GC

# ======================
# MONITORING CONFIGURATION
# ======================
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3

# ======================
# SECURITY CONFIGURATION
# ======================
# Nota: En producción, usar secretos seguros y no commitear al repositorio
SA_PASSWORD=j1s0n2108*
JWT_SECRET=
API_KEY=

# ======================
# LOGGING CONFIGURATION
# ======================
LOG_LEVEL=INFO
LOG_PATTERN=%d{yyyy-MM-dd HH:mm:ss} - %msg%n

# ======================
# PERFORMANCE CONFIGURATION
# ======================
HIKARI_MAXIMUM_POOL_SIZE=10
HIKARI_MINIMUM_IDLE=5
HIKARI_CONNECTION_TIMEOUT=30000
HIKARI_IDLE_TIMEOUT=300000
